AGENTMAIL_STORAGE_ROOT=/var/lib/agentmail
AGENTMAIL_DB_PATH=/var/lib/agentmail/agentmail.db

AGENTMAIL_BIND_HOST=0.0.0.0
AGENTMAIL_BIND_PORT=8787

AGENTMAIL_INGEST_TOKEN=change-this-ingest-token
AGENTMAIL_API_TOKEN=change-this-api-token
AGENTMAIL_AUTH_DISABLED=false

AGENTMAIL_ALLOWED_SENDERS=gpt@wantwhat.co.uk

AGENTMAIL_MAX_EMAIL_BYTES=26214400
AGENTMAIL_MAX_ATTACHMENT_BYTES=26214400

AGENTMAIL_BLOCKED_EXTENSIONS=.exe,.msi,.bat,.cmd,.ps1,.sh,.js,.cjs,.mjs,.jar,.scr,.vbs,.hta,.reg,.com,.pif,.apk,.dmg,.iso

AGENTMAIL_FORWARD_COPY_TO=
